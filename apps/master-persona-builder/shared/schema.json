{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Master Persona Builder Payload",
  "type": "object",
  "required": ["meta", "master"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["slug", "name", "description"],
      "additionalProperties": true,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "default": "1.0.0" },
        "language": { "type": "string", "default": "zh-TW" },
        "target_platforms": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["claude", "codex"]
        }
      }
    },
    "master": {
      "type": "object",
      "required": ["display_name"],
      "additionalProperties": true,
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "dynasty": { "type": "string" },
        "titles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "historical_context": { "type": "string" },
        "literary_school": { "type": "string" },
        "core_philosophy": { "type": "string" }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "core_values": { "$ref": "#/$defs/stringList" },
        "intellectual_axes": { "$ref": "#/$defs/stringList" },
        "worldview_tensions": { "$ref": "#/$defs/stringList" },
        "preferred_themes": { "$ref": "#/$defs/stringList" },
        "emotional_signature": { "$ref": "#/$defs/stringList" },
        "timeline_milestones": { "$ref": "#/$defs/stringList" },
        "geography_path": { "$ref": "#/$defs/stringList" },
        "relationships": { "$ref": "#/$defs/stringList" },
        "voice_anchors": { "$ref": "#/$defs/stringList" },
        "anachronism_policy": { "$ref": "#/$defs/stringList" },
        "citation_ids": { "$ref": "#/$defs/stringList" }
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "l1_hard_rules": { "$ref": "#/$defs/stringList" },
        "l2_identity_role": { "$ref": "#/$defs/stringList" },
        "l3_expression_style": { "$ref": "#/$defs/stringList" },
        "lexicon_preferences": { "$ref": "#/$defs/stringList" },
        "rhythm_structure": { "$ref": "#/$defs/stringList" },
        "l4_judgment_logic": { "$ref": "#/$defs/stringList" },
        "decision_ladder": { "$ref": "#/$defs/stringList" },
        "l5_social_conduct": { "$ref": "#/$defs/stringList" },
        "audience_tone": { "$ref": "#/$defs/stringList" },
        "anti_patterns": { "$ref": "#/$defs/stringList" },
        "rewrite_strategies": { "$ref": "#/$defs/stringList" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "trigger": { "type": "string" },
        "update": { "type": "string" },
        "list": { "type": "string" },
        "delete": { "type": "string" }
      }
    },
    "source_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "content"],
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "enum": ["works", "criticism", "letters", "biography", "citation"]
          },
          "title": { "type": "string" },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
